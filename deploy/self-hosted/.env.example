SITE_DOMAIN=example.edu
APP_NETWORK_OCTET=77
ACME_EMAIL=admin@example.edu
PUBLIC_DATA_DIR=/srv/scs/public-data

# Generate separate random credentials. URL-encode passwords inside connection URLs.
POSTGRES_ADMIN_PASSWORD=replace-with-random-admin-password
API_DB_PASSWORD=replace-with-random-api-password
GITHUB_DB_PASSWORD=replace-with-random-worker-password
MIGRATION_DB_PASSWORD=replace-with-random-migration-password
API_POSTGRES_URL=postgresql://scs_api:replace-with-random-api-password@postgres:5432/scs
GITHUB_POSTGRES_URL=postgresql://scs_worker:replace-with-random-worker-password@postgres:5432/scs
POSTGRES_MIGRATION_URL=postgresql://scs_migrator:replace-with-random-migration-password@postgres:5432/scs

S3_ACCESS_KEY_ID=replace-with-random-access-key
S3_SECRET_ACCESS_KEY=replace-with-random-storage-secret
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
WEB_PROXY_INTERNAL_SECRET=replace-with-random-web-api-secret
GITHUB_APP_INTERNAL_SECRET=replace-with-random-api-github-secret
MAILER_API_KEY=replace-with-random-mailer-secret
TYPESAFE_API_KEY=replace-with-typesafe-staging-or-production-key

GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_PRIVATE_KEY=replace-with-pem-with-escaped-newlines
GITHUB_INSTALLATION_ID=replace-with-github-installation-id
GITHUB_OWNER=replace-with-github-owner
GITHUB_PEOPLE_DATA_REPOSITORY=replace-with-data-repository
GITHUB_PROJECTS_DATA_REPOSITORY=replace-with-data-repository

SMTP_HOST=replace-with-smtp-host
SMTP_SECURE=true
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=notifications@example.edu
MOODLE_URL=https://scilms.pdn.ac.lk
