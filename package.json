{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "scs-pdn-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "portless",
    "dev": "portless",
    "prebuild": "bun scripts/inject-config.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "inject:config": "bun scripts/inject-config.ts"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "auto",
    "overrides": [
      {
        "files": "*.jsonc",
        "options": {
          "trailingComma": "none"
        }
      }
    ]
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.2",
    "chalk": "^5.6.2",
    "husky": "^9.1.7",
    "portless": "^0.13.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.12"
  },
  "packageManager": "bun@1.3.1"
}
