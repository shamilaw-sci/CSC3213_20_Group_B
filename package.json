{
  "name": "scs-pdn-monorepo",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "typecheck:test": "turbo run typecheck:test",
    "docs:check": "bun scripts/check-documentation.mts",
    "knip": "turbo knip",
    "test:docs": "bun test test/repository/check-documentation.test.ts",
    "test:repo": "bun test test/repository",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 80,
    "classnamesPrintWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "auto",
    "plugins": [
      "prettier-plugin-tailwindcss",
      "prettier-plugin-classnames",
      "prettier-plugin-merge"
    ],
    "overrides": [
      {
        "files": "*.jsonc",
        "options": {
          "trailingComma": "none"
        }
      }
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@scs/tsconfig": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/node": "^25.9.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-classnames": "^0.10.4",
    "prettier-plugin-merge": "^0.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.9",
    "typescript": "^6.0.3"
  }
}
