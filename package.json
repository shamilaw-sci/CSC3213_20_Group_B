{
  "name": "scs-pdn-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n main,portal,people,projects,api,worker -c blue,green,yellow,magenta,cyan,white \"npm run dev:main\" \"npm run dev:portal\" \"npm run dev:people\" \"npm run dev:projects\" \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:main": "cd apps/main-site && npx next dev -p 3001",
    "dev:portal": "cd apps/portal && npx next dev -p 3002",
    "dev:people": "cd apps/people && npx next dev -p 3003",
    "dev:projects": "cd apps/projects && npx next dev -p 3004",
    "dev:api": "cd apps/api && npx tsx watch src/node.ts",
    "dev:worker": "cd apps/auth-worker && npx wrangler dev --port 8787",
    "prebuild": "tsx scripts/inject-config.ts",
    "build": "turbo run build",
    "format": "prettier --write .",
    "inject:config": "tsx scripts/inject-config.ts"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "auto",
    "overrides": [
      {
        "files": "*.jsonc",
        "options": {
          "trailingComma": "none"
        }
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "bun-types": "^1.3.11",
    "chalk": "^5.6.2",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "turbo": "^2.8.19",
    "wrangler": "^4.75.0"
  },
  "packageManager": "bun@1.3.1"
}
