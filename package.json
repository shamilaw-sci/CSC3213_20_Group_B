{
  "name": "scs-pdn-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "predev": "kill-port 3000 3001 3002 3003 3004 3005 8787 8788 8789 || true",
    "dev": "concurrently --prefix \"[{name}]\" -n main,portal,people,projects,api,auth,proxy,github-app -c blue,green,magenta,cyan,blueBright,greenBright,magentaBright,cyanBright \"bun dev:main\" \"bun dev:portal\" \"bun dev:people\" \"bun dev:projects\" \"bun dev:api\" \"bun dev:worker:auth\" \"bun dev:worker:proxy\" \"bun dev:github:app\"",
    "dev:main": "bun --filter=\"scs.pdn.ac.lk\" dev -p 3001",
    "dev:portal": "bun --filter=\"portal.scs.pdn.ac.lk\" dev -p 3002",
    "dev:people": "bun --filter=\"people.scs.pdn.ac.lk\" dev -p 3003",
    "dev:projects": "bun --filter=\"projects.scs.pdn.ac.lk\" dev -p 3004",
    "dev:api": "bun --filter=\"api.scs.pdn.ac.lk\" dev",
    "dev:worker:auth": "bun --filter=\"scs-portal-auth-app\" dev --port 8787",
    "dev:worker:proxy": "bun --filter=\"scs-proxy-worker\" dev --port 8788",
    "dev:github:app": "bun --filter=\"scs-portal-github-app\" dev --port 8789",
    "prebuild": "bun scripts/inject-config.ts",
    "build": "turbo run build",
    "format": "prettier --write .",
    "inject:config": "bun scripts/inject-config.ts"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "auto",
    "overrides": [
      {
        "files": "*.jsonc",
        "options": {
          "trailingComma": "none"
        }
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "bun-types": "^1.3.11",
    "chalk": "^5.6.2",
    "concurrently": "^9.2.1",
    "kill-port": "^2.0.1",
    "prettier": "^3.8.1",
    "turbo": "^2.8.19"
  },
  "packageManager": "bun@1.3.1"
}
