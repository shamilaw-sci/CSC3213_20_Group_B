{
  "name": "scs-pdn-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:main": "bun --filter=main-site dev -p 3001",
    "dev:portal": "bun --filter=portal dev -p 3002",
    "dev:people": "bun --filter=people dev -p 3003",
    "dev:projects": "bun --filter=projects dev -p 3004",
    "dev:api": "bun --filter=api dev",
    "dev:worker:auth": "bun --filter=auth-worker dev --port 8787",
    "dev:worker:proxy": "bun --filter=proxy-worker dev dev --port 8788",
    "prebuild": "tsx scripts/inject-config.ts",
    "build": "turbo run build",
    "format": "prettier --write .",
    "inject:config": "tsx scripts/inject-config.ts"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "auto",
    "overrides": [
      {
        "files": "*.jsonc",
        "options": {
          "trailingComma": "none"
        }
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "bun-types": "^1.3.11",
    "chalk": "^5.6.2",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "turbo": "^2.8.19"
  },
  "packageManager": "bun@1.3.1"
}
