{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "types": ["@cloudflare/workers-types"]
  }
}
