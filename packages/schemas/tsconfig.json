{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "extends": "@scs/tsconfig/library.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node", "bun"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
