{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@scs/schemas",
  "private": true,
  "description": "Shared academic domain schemas for the SCS PDN monorepo",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "imports": {
    "#index": "./src/index.ts",
    "#schemas/*": "./src/schemas/*.ts"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@scs/eslint-config": "workspace:*",
    "@scs/tsconfig": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/node": "^25.9.9",
    "eslint": "^9.39.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "tsc-alias": "^1.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
