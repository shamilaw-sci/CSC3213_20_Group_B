{
  "$schema": "https://turbo.build/schema.json",
  "cacheMaxAge": "7d",
  "cacheMaxSize": "2GB",
  "tasks": {
    "perf:check": { "cache": false },
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": { "dependsOn": ["^lint"] },
    "knip": { "dependsOn": ["^knip"] },
    "test": { "dependsOn": ["^test"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "typecheck:test": { "dependsOn": ["^typecheck:test"] }
  }
}
