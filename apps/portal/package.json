{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@scs/portal",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --cache --cache-strategy content --cache-location .cache/eslint/",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --cache --cache-strategy content --cache-location .cache/eslint/ --fix",
    "format": "prettier --write .",
    "prune:code:check": "ts-prune",
    "generate:assets": "tsx scripts/public-assets-generator.ts --generate-favicons",
    "knip": "knip",
    "knip:depcheck": "knip --dependencies",
    "knip:fix": "knip --fix"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@scs/schemas": "workspace:*",
    "@simplewebauthn/browser": "^13.3.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@uiw/react-json-view": "^2.0.0-alpha.43",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.2.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@scs/eslint-config": "workspace:*",
    "@scs/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "knip": "^6.32.2",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.26",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "ts-prune": "0.10.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
