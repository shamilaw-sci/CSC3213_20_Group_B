{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@scs/portal",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --cache --cache-strategy content --cache-location .cache/eslint/",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --cache --cache-strategy content --cache-location .cache/eslint/ --fix",
    "format": "prettier --write .",
    "prune:code:check": "ts-prune",
    "knip": "knip",
    "knip:depcheck": "knip --dependencies",
    "knip:fix": "knip --fix"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@codemirror/lang-json": "^6.0.2",
    "@scs/schemas": "workspace:*",
    "@scs/ui": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@uiw/react-json-view": "^2.0.0-alpha.43",
    "better-auth": "^1.7.7",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sonner": "^2.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@scs/eslint-config": "workspace:*",
    "@scs/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "knip": "^6.41.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "ts-prune": "^0.10.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "ignoreScripts": [
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
