{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@scs/web",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --cache --cache-strategy content --cache-location .cache/eslint/",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --cache --cache-strategy content --cache-location .cache/eslint/ --fix",
    "format": "prettier --write .",
    "prune:code:check": "ts-prune",
    "knip": "knip",
    "knip:depcheck": "knip --dependencies",
    "knip:fix": "knip --fix"
  },
  "dependencies": {
    "@scs/ui": "workspace:*",
    "lucide-react": "^1.14.0",
    "next": "16.2.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@scs/eslint-config": "workspace:*",
    "@scs/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "knip": "^6.12.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "ts-prune": "^0.10.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
