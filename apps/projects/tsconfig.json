{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "extends": "@scs/tsconfig/nextjs.json",
  "compilerOptions": {
    "types": ["bun"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [".agents", ".cache", ".next", ".turbo", "node_modules", "tests"]
}
