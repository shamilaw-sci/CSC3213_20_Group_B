{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@scs/projects",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint \"{src,tests}/**/*.{ts,tsx}\" --cache --cache-strategy content --cache-location .cache/eslint/",
    "lint:fix": "eslint \"{src,tests}/**/*.{ts,tsx}\" --cache --cache-strategy content --cache-location .cache/eslint/ --fix",
    "format": "prettier --write .",
    "prune:code:check": "ts-prune",
    "knip": "knip",
    "knip:depcheck": "knip --dependencies",
    "knip:fix": "knip --fix"
  },
  "dependencies": {
    "@scs/schemas": "workspace:*",
    "@scs/ui": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@scs/eslint-config": "workspace:*",
    "@scs/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "jsdom": "^22.1.0",
    "knip": "^6.41.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "ts-prune": "^0.10.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "ignoreScripts": [
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
