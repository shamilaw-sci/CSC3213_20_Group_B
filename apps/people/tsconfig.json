{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "extends": "@scs/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.mts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [".agents", ".cache", ".next", ".turbo", "node_modules"]
}
