{
  "name": "@scs/mailer",
  "description": "Transactional email API for SCS PDN",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "hono": "^4.12.30",
    "nodemailer": "^6.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@scs/tsconfig": "workspace:*",
    "@types/bun": "^1.4.3",
    "@types/nodemailer": "^8.0.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
