{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "extends": "./tsconfig.worker.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "bun"],
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"],
      "test/*": ["./test/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
