{
  "$schema": "https://www.unpkg.com/wrangler/config-schema.json",
  "name": "api-scs-pdn-ac-lk",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.scs-pdn.space",
      "custom_domain": true
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://api.scs-pdn.space",
    "GOOGLE_CLIENT_ID": "745767843751-p01q3t3sat4m38ae7fp51c7h88gnvjqv.apps.googleusercontent.com",
    "GITHUB_CLIENT_ID": "Ov23lieXg7aKWvl5dC0M",
    "MAILER_API_URL": "https://mailer.scs-pdn.space",
    "GITHUB_APP_API_URL": "https://gh.scs-pdn.space",
    "DATA_PUBLIC_BASE_URL": "https://data.scs-pdn.space"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "GOOGLE_CLIENT_SECRET",
      "GITHUB_CLIENT_SECRET",
      "MAILER_API_KEY",
      "GITHUB_APP_INTERNAL_SECRET",
      "WEB_PROXY_INTERNAL_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "scs-portal-auth",
      "database_id": "1aa9fb1b-17ae-42cf-b39b-54c53bf8f743",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "GITHUB_APP",
      "service": "scs-portal-github-app"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
