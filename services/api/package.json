{
  "name": "@scs/api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler build",
    "deploy": "wrangler deploy",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "eslint \"src/**/*.ts\" --cache --cache-strategy content --cache-location .cache/eslint/",
    "lint:fix": "eslint \"src/**/*.ts\" --cache --cache-strategy content --cache-location .cache/eslint/ --fix",
    "format": "prettier --write .",
    "knip": "knip",
    "knip:depcheck": "knip --dependencies",
    "knip:fix": "knip --fix"
  },
  "dependencies": {
    "@scs/schemas": "workspace:*",
    "@simplewebauthn/server": "^13.3.2",
    "jose": "^6.2.3",
    "ms": "^2.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@scs/eslint-config": "workspace:*",
    "@scs/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/bun": "^1.3.14",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.9.5",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "knip": "^6.26.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.110.0"
  }
}
