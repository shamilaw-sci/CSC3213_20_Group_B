{
  "name": "@scs/api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "start:bun": "bun src/server.ts",
    "build": "wrangler build",
    "deploy": "wrangler deploy",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "eslint \"src/**/*.ts\" --cache --cache-strategy content --cache-location .cache/eslint/",
    "lint:fix": "eslint \"src/**/*.ts\" --cache --cache-strategy content --cache-location .cache/eslint/ --fix",
    "format": "prettier --write .",
    "knip": "knip",
    "knip:depcheck": "knip --dependencies",
    "knip:fix": "knip --fix"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@scs/moderation": "workspace:*",
    "@scs/schemas": "workspace:*",
    "@scs/security": "workspace:*",
    "@scs/storage": "workspace:*",
    "better-auth": "^1.7.7",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260713.1",
    "@scs/eslint-config": "workspace:*",
    "@scs/tsconfig": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.110.0"
  }
}
