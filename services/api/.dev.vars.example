# Copy to .dev.vars for local Wrangler development. Never commit .dev.vars.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
TYPESAFE_API_KEY=replace-with-typesafe-api-key
GOOGLE_CLIENT_SECRET=replace-with-a-local-secret
GITHUB_CLIENT_SECRET=replace-with-a-local-secret
MAILER_API_KEY=replace-with-a-local-secret
GITHUB_APP_INTERNAL_SECRET=replace-with-a-local-secret
WEB_PROXY_INTERNAL_SECRET=replace-with-the-same-secret-as-apps-web
