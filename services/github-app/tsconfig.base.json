{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "extends": "@scs/tsconfig/worker.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "moduleDetection": "force",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "tests/*": ["./tests/*"]
    }
  }
}
