{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@scs/github-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "wrangler build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "knip": "knip",
    "knip:depcheck": "knip --dependencies",
    "knip:fix": "knip --fix"
  },
  "dependencies": {
    "@scs/schemas": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "hono": "^4.12.30",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@scs/eslint-config": "workspace:*",
    "@scs/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "^5.20260713.1",
    "@types/bun": "^1.3.14",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "knip": "^6.26.0",
    "prettier": "^3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "wrangler": "^4.110.0"
  }
}
