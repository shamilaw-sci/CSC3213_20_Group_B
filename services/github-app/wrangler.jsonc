{
  "$schema": "https://www.unpkg.com/wrangler/config-schema.json",
  "name": "scs-portal-github-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "gh.scs-pdn.space",
      "custom_domain": true
    }
  ],
  "vars": {
    "GITHUB_APP_ID": "2772312",
    "GITHUB_INSTALLATION_ID": "110608346",
    "GITHUB_OWNER": "csc3213-2026-group-b",
    "GITHUB_CONFIG_REPOSITORY": "config.scs.pdn.ac.lk",
    "GITHUB_PEOPLE_DATA_REPOSITORY": "data.scs.pdn.ac.lk",
    "GITHUB_PROJECTS_DATA_REPOSITORY": "data.scs.pdn.ac.lk",
    "PORT": "3000"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
