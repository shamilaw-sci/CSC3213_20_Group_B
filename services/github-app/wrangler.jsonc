{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "scs-portal-github-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "gh.scs-pdn.space",
      "custom_domain": true
    }
  ],
  "vars": {
    "GITHUB_APP_ID": "2772312",
    "GITHUB_INSTALLATION_ID": "110608346",
    "GITHUB_OWNER": "csc3213-2026-group-b",
    "GITHUB_PEOPLE_DATA_REPOSITORY": "data.scs.pdn.ac.lk",
    "GITHUB_PROJECTS_DATA_REPOSITORY": "data.scs.pdn.ac.lk"
  },
  "secrets": {
    "required": ["GITHUB_PRIVATE_KEY", "X_INTERNAL_SECRET"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OPERATION_STATE",
        "class_name": "OperationStateDurableObject"
      },
      {
        "name": "MUTATION_COORDINATOR",
        "class_name": "MutationCoordinatorDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-operation-runtime",
      "new_sqlite_classes": [
        "OperationStateDurableObject",
        "MutationCoordinatorDurableObject"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "OPERATION_QUEUE",
        "queue": "scs-github-operations"
      }
    ],
    "consumers": [
      {
        "queue": "scs-github-operations",
        "dead_letter_queue": "scs-github-operations-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 5
      }
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
